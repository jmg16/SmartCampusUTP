# Ejemplo de configuración Nginx para Smart Campus UTP Chiriquí
# Copiar a /etc/nginx/sites-available/ y enlazar desde sites-enabled.
# Reemplazar /ruta/al/proyecto y server_name según el servidor.

server {
    listen 80;
    server_name smartcampusch.utp.ac.pa;

    # Frontend Angular (archivos estáticos del build)
    root /ruta/al/proyecto/smartcampus-web/dist/smartcampus-web/browser;
    index index.html;

    # API → Backend Node.js (Express en puerto 3000)
    location /api {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: todas las rutas sirven index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Opcional: cache para assets con hash
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}

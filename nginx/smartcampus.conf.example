# Configuración Nginx para Smart Campus UTP Chiriquí
# Reemplaza tu bloque server actual (el que solo hace proxy_pass a 3000) por este.
#
# En el servidor:
#   1. Editar y poner la ruta real del build (abajo en "root").
#   2. sudo cp nginx/smartcampus.conf.example /etc/nginx/sites-available/smartcampus
#   3. sudo ln -sf /etc/nginx/sites-available/smartcampus /etc/nginx/sites-enabled/
#   4. sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name smartcampusch.utp.ac.pa;

    # Frontend Angular: archivos estáticos del build (NO proxy todo a Node)
    root /home/jmartinez/smartcampus/smartcampus-web/dist/smartcampus-web/browser;
    index index.html;

    # API → Backend Node.js (Express en puerto 3000)
    location /api {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: rutas de Angular (/, /admin, /admin/login, etc.) sirven index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache para assets con hash
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
